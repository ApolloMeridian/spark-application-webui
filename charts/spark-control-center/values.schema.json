{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "runtimeConfig", "service"],
  "definitions": {
    "annotationMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "properties": {
    "podAnnotations": { "$ref": "#/definitions/annotationMap" },
    "serviceAccount": {
      "type": "object",
      "properties": { "annotations": { "$ref": "#/definitions/annotationMap" } }
    },
    "ingress": {
      "type": "object",
      "properties": { "annotations": { "$ref": "#/definitions/annotationMap" } }
    },
    "objectStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 10 },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "annotations": { "$ref": "#/definitions/annotationMap" }
          }
        },
        "internalAuth": {
          "type": "object",
          "required": ["existingSecret", "signingKeyKey"],
          "properties": {
            "existingSecret": { "type": "string" },
            "signingKeyKey": { "type": "string", "minLength": 1 }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "dsnKey": { "type": "string", "minLength": 1 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "textMaxBytes",
            "maxUploadBytes",
            "maxDownloadBytes",
            "partSizeBytes",
            "maxConcurrentTransfers",
            "requestsPerMinute",
            "transferTimeoutSeconds"
          ],
          "properties": {
            "textMaxBytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 8388608
            },
            "maxUploadBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            },
            "maxDownloadBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1099511627776
            },
            "partSizeBytes": {
              "type": "integer",
              "minimum": 5242880,
              "maximum": 16777216,
              "multipleOf": 262144
            },
            "maxConcurrentTransfers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "requestsPerMinute": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6000
            },
            "transferTimeoutSeconds": {
              "type": "integer",
              "minimum": 30,
              "maximum": 3600
            }
          }
        },
        "audit": {
          "type": "object",
          "properties": {
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            }
          }
        },
        "resources": { "type": "object" },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "egress": { "type": "array" }
          }
        },
        "bootstrapGrants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "username",
              "tenantId",
              "connection",
              "prefix",
              "actions"
            ],
            "anyOf": [
              { "required": ["bucket"] },
              {
                "required": ["allBuckets"],
                "properties": { "allBuckets": { "const": true } }
              }
            ],
            "properties": {
              "allBuckets": { "type": "boolean" },
              "username": { "type": "string", "minLength": 1 },
              "tenantId": { "type": "string", "minLength": 1 },
              "connection": { "type": "string", "minLength": 1 },
              "bucket": { "type": "string", "minLength": 1 },
              "prefix": {
                "type": "string",
                "maxLength": 1024,
                "pattern": "^$|/$"
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "list",
                    "read",
                    "download",
                    "upload",
                    "edit",
                    "delete",
                    "copy-source",
                    "copy-destination"
                  ]
                }
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "provider", "buckets"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
              "name": { "type": "string", "minLength": 1 },
              "provider": { "enum": ["s3", "gcs"] },
              "buckets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              },
              "s3": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "endpoint",
                  "region",
                  "forcePathStyle",
                  "conditionalWrites",
                  "credentialsSecret",
                  "accessKeyKey",
                  "secretKeyKey"
                ],
                "properties": {
                  "endpoint": { "type": "string", "pattern": "^https?://" },
                  "region": { "type": "string", "minLength": 1 },
                  "forcePathStyle": { "type": "boolean" },
                  "conditionalWrites": { "type": "boolean" },
                  "credentialsSecret": { "type": "string", "minLength": 1 },
                  "accessKeyKey": { "type": "string", "minLength": 1 },
                  "secretKeyKey": { "type": "string", "minLength": 1 },
                  "caConfigMap": { "type": "string" },
                  "caKey": { "type": "string" }
                }
              },
              "gcs": {
                "type": "object",
                "additionalProperties": false,
                "required": ["projectID", "authMode"],
                "properties": {
                  "projectID": { "type": "string", "minLength": 1 },
                  "authMode": { "enum": ["gkeWif", "kubernetesWif"] },
                  "workloadIdentity": {
                    "type": "object",
                    "properties": {
                      "audience": { "type": "string", "minLength": 1 },
                      "credentialConfigMap": {
                        "type": "string",
                        "minLength": 1
                      },
                      "credentialKey": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": { "authMode": { "const": "kubernetesWif" } }
                    },
                    "then": {
                      "required": ["workloadIdentity"],
                      "properties": {
                        "workloadIdentity": {
                          "required": ["audience", "credentialConfigMap"]
                        }
                      }
                    }
                  }
                ]
              }
            },
            "oneOf": [
              {
                "properties": { "provider": { "const": "s3" } },
                "required": ["s3"],
                "not": { "required": ["gcs"] }
              },
              {
                "properties": { "provider": { "const": "gcs" } },
                "required": ["gcs"],
                "not": { "required": ["s3"] }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "required": ["connections", "internalAuth"],
            "properties": {
              "connections": { "minItems": 1 },
              "internalAuth": {
                "properties": { "existingSecret": { "minLength": 1 } }
              }
            }
          }
        }
      ]
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timeZone", "maxNodes", "scheduler"],
      "properties": {
        "enabled": { "type": "boolean" },
        "timeZone": { "type": "string", "minLength": 1 },
        "maxNodes": { "type": "integer", "minimum": 1, "maximum": 100 },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "scanInterval",
            "maxActiveRuns",
            "maxActiveTasks",
            "maxCatchupRuns"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "scanInterval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(s|m)$"
            },
            "maxActiveRuns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "maxActiveTasks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxCatchupRuns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "runtimeConfig": {
      "type": "object",
      "required": [
        "dataMode",
        "api",
        "auth",
        "cluster",
        "dashboard",
        "historyServer",
        "features"
      ],
      "properties": {
        "timeZone": { "type": "string" },
        "dataMode": { "enum": ["mock", "api"] },
        "api": {
          "type": "object",
          "required": ["baseUrl", "requestTimeoutMs"],
          "properties": {
            "baseUrl": { "type": "string" },
            "requestTimeoutMs": { "type": "integer", "minimum": 1000 }
          }
        },
        "auth": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["mock", "local", "oidc"] }
          }
        },
        "cluster": {
          "type": "object",
          "required": ["name", "namespaces"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "namespaces": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "dashboard": {
          "type": "object",
          "required": ["refreshIntervalSeconds", "defaultHistoryDays"],
          "properties": {
            "refreshIntervalSeconds": { "type": "integer", "minimum": 5 },
            "defaultHistoryDays": { "type": "integer", "minimum": 1 }
          }
        },
        "historyServer": {
          "type": "object",
          "required": ["enabled", "baseUrl"],
          "properties": {
            "enabled": { "type": "boolean" },
            "baseUrl": { "type": "string" }
          }
        },
        "features": { "type": "object" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "annotations": { "$ref": "#/definitions/annotationMap" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "podAnnotations": { "$ref": "#/definitions/annotationMap" },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "annotations": { "$ref": "#/definitions/annotationMap" }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "sessionTTL": { "type": "string", "minLength": 1 },
            "bcryptCost": { "type": "integer", "minimum": 10, "maximum": 15 },
            "initialAdmin": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 64
                },
                "displayName": { "type": "string" },
                "existingSecret": { "type": "string" },
                "passwordKey": { "type": "string", "minLength": 1 },
                "createSecret": { "type": "boolean" },
                "password": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "required": [
        "enabled",
        "providerName",
        "issuerURL",
        "clientID",
        "scopes",
        "usernameClaim",
        "groupsClaim",
        "adminGroups",
        "autoCreate",
        "stateTTL"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "providerName": { "type": "string", "minLength": 1 },
        "issuerURL": { "type": "string" },
        "clientID": { "type": "string" },
        "scopes": {
          "type": "array",
          "contains": { "const": "openid" },
          "items": { "type": "string", "minLength": 1 }
        },
        "usernameClaim": { "type": "string", "minLength": 1 },
        "groupsClaim": { "type": "string", "minLength": 1 },
        "adminGroups": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "autoCreate": { "type": "boolean" },
        "redirectURL": { "type": "string" },
        "stateTTL": { "type": "string", "minLength": 1 },
        "ca": {
          "type": "object",
          "required": ["existingConfigMap", "key", "mountPath"],
          "properties": {
            "existingConfigMap": { "type": "string" },
            "key": { "type": "string", "minLength": 1 },
            "mountPath": { "type": "string", "pattern": "^/" }
          }
        },
        "caFile": { "type": "string" }
      }
    },
    "oidcSecret": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "create": { "type": "boolean" },
        "clientSecret": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "clusterWide": { "type": "boolean" },
        "namespaces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prometheus": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "queryTimeout": { "type": "string", "minLength": 1 },
        "lookback": { "type": "string", "minLength": 1 },
        "queryStep": { "type": "string", "minLength": 1 },
        "cpuRateWindow": { "type": "string", "minLength": 1 }
      }
    },
    "loki": {
      "type": "object",
      "required": ["enabled", "url", "queryTimeout", "maxEntries"],
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string" },
        "queryTimeout": { "type": "string", "minLength": 1 },
        "maxEntries": { "type": "integer", "minimum": 1, "maximum": 5000 }
      }
    },
    "alerts": {
      "type": "object",
      "required": ["evaluationInterval", "webhook"],
      "properties": {
        "evaluationInterval": { "type": "string", "minLength": 1 },
        "webhook": {
          "type": "object",
          "required": ["enabled", "url", "timeout"],
          "properties": {
            "enabled": { "type": "boolean" },
            "url": { "type": "string" },
            "timeout": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
